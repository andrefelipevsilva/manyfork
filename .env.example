# manyfork — copie para .env e preencha. NUNCA cole estes valores no chat.

# URL pública do painel (sem barra no fim). Em dev: http://localhost:3010
APP_URL=http://localhost:3010

# Postgres (dev: `npm run db:up` sobe na porta 5440)
DATABASE_URL=postgresql://manyfork:manyfork@localhost:5440/manyfork

# Segredos aleatórios: `npm run segredos`
SESSION_SECRET=
ENCRYPTION_KEY=
WEBHOOK_VERIFY_TOKEN=

# Senha do painel: `npm run senha -- "sua senha"`
ADMIN_PASSWORD_HASH=

# Quem responde pelos dados (aparece nas páginas /privacidade e /exclusao-de-dados)
RESPONSAVEL_NOME=
RESPONSAVEL_EMAIL=

# Meta for Developers → seu app → Instagram → "Configuração da API com login do Instagram"
IG_APP_ID=
IG_APP_SECRET=
# Meta for Developers → seu app → Configurações do app → Básico → Chave secreta do app
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# Brevo (opcional): Brevo → SMTP e API → Chaves de API
BREVO_API_KEY=
BREVO_ATRIB_NOME=FIRSTNAME
