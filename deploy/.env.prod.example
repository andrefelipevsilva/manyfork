# Copie para deploy/.env.prod NO SERVIDOR (chmod 600). Nunca commitar.

# Domínio do painel, sem https:// (ex.: auto.seudominio.com.br). O registro DNS
# tipo A precisa apontar pro IP do servidor antes de subir.
DOMINIO=

# Senha do Postgres: openssl rand -hex 24
POSTGRES_PASSWORD=

# Segredos aleatórios: `npm run segredos` (gere NOVOS pra produção, não reaproveite os do dev)
SESSION_SECRET=
ENCRYPTION_KEY=
WEBHOOK_VERIFY_TOKEN=

# Senha do painel: npm run senha -- "sua senha forte"
ADMIN_PASSWORD_HASH=

# Quem responde pelos dados (aparece nas páginas /privacidade e /exclusao-de-dados)
RESPONSAVEL_NOME=
RESPONSAVEL_EMAIL=

# Meta for Developers → seu app → Instagram → Configuração da API com login do Instagram
IG_APP_ID=
IG_APP_SECRET=
# Meta for Developers → seu app → Configurações do app → Básico → Chave secreta do app
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# Brevo (opcional): Brevo → SMTP e API → Chaves de API
BREVO_API_KEY=
BREVO_ATRIB_NOME=FIRSTNAME

# Só com deploy/proxy-externo.yml: rede Docker do seu proxy reverso
# PROXY_NETWORK=
